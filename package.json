{
  "name": "hallwright",
  "version": "2.0.0",
  "description": "Hallwright: A guardrail layer for AI coding agents: pre-commit gate, living project memory, and subagent/skill definitions.",
  "main": "bin/hallwright.js",
  "bin": {
    "hallwright": "./bin/hallwright.js",
    "artisan": "./bin/hallwright.js"
  },
  "scripts": {
    "init": "node bin/artisan.js init",
    "audit": "node bin/artisan.js audit",
    "fix": "node bin/artisan.js fix",
    "memory": "node bin/artisan.js memory",
    "status": "node bin/artisan.js status",
    "hud": "python cli/dashboard.py",
    "watchdog": "python scripts/watchdog.py",
    "gatekeeper": "python scripts/pre-commit-gatekeeper.py",
    "metrics": "python scripts/roi_tracker.py",
    "mcp": "python mcp/server.py",
    "test": "pytest tests/"
  },
  "keywords": [
